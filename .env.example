# =============================================================================
# Variables de entorno de Vagando
# -----------------------------------------------------------------------------
# 1. Copia este archivo como .env.local:   cp .env.example .env.local
# 2. Reemplaza los valores de ejemplo por los reales.
# 3. .env.local NUNCA se sube al repositorio (ya está en .gitignore).
#
# Reglas (AGENTS.md 3.8):
# - Estas keys solo se usan en el servidor (Route Handlers y services).
# - NUNCA agregar el prefijo NEXT_PUBLIC_: expondría la key en el navegador.
#
# En producción (Vercel), configura estas mismas variables en:
#   Project → Settings → Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# REST_COUNTRIES_API_KEY  (obligatoria)
# API key de REST Countries v5, usada para los datos de los países.
# - Se obtiene gratis en https://restcountries.com/sign-up → API Keys
# - Plan gratuito: 1000 peticiones por mes, y máximo 20 peticiones cada 10 segundos.
# - Se envía en el header "Authorization: Bearer <key>", nunca en la URL.
# - Para probar la API sin gastar cuota existe la key pública de demo: rc_live_demo
#   (devuelve datos de ejemplo, no reales).
# -----------------------------------------------------------------------------
REST_COUNTRIES_API_KEY=your_rest_countries_api_key_here

# -----------------------------------------------------------------------------
# GEOAPIFY_API_KEY  (obligatoria)
# API key de Geoapify Places, usada para obtener los lugares turísticos.
# - Se obtiene gratis en https://myprojects.geoapify.com → tu proyecto → API keys
# - Plan gratuito: 3000 peticiones por día.
# - Geoapify la recibe como query param (apiKey=...). El logger la oculta automáticamente.
# -----------------------------------------------------------------------------
GEOAPIFY_API_KEY=your_geoapify_api_key_here
